{
  "expo": {
    "name": "JARVIS TRACKER",
    "slug": "jarvis-tracker",
    "owner": "jarvismok77",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "jarvistracker",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router"
    ],
    "android": {
      "package": "com.jarvis.tracker",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#07100D"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "experiments": {
      "typedRoutes": true
    }
  },
  "experiments": {
    "baseUrl": "/jarvis-tracker",
    "typedRoutes": true
  }
}
